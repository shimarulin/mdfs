#compdef mdfs

_mdfs() {
    local -a commands
    commands=(
        'init:Initialize .mdfs directory structure'
        'bundle:Bundle rules and/or files into a context Markdown file'
        'paste:Save clipboard as response, optionally extract files'
        'extract:Extract files and apply patches from Markdown'
        'log:Show chronological log of contexts and responses'
        'setup:Install/uninstall shell completions'
    )

    _arguments -C \
        '(-)1:command:->command' \
        '*::arg:->args' \
        '-d[Project directory]:directory:_directories' \
        '--dir[Project directory]:directory:_directories' \
        '--contexts-dir[Override contexts directory]:directory:_directories' \
        '--responses-dir[Override responses directory]:directory:_directories' \
        '--rules-dir[Override rules directory]:directory:_directories' \
        '(-v --version)'{-v,--version}'[Show version]'

    case "$state" in
        command)
            _describe -t commands 'mdfs command' commands
            ;;
        args)
            case "$words[1]" in
                init)
                    _arguments \
                        '--contexts-dir[Override contexts directory]:directory:_directories' \
                        '--responses-dir[Override responses directory]:directory:_directories' \
                        '--rules-dir[Override rules directory]:directory:_directories'
                    ;;
                bundle)
                    _arguments \
                        '*:file:_files' \
                        '-l[Label for context file]:label:' \
                        '--label[Label for context file]:label:' \
                        '-o[Output file]:file:_files' \
                        '--output[Output file]:file:_files' \
                        '-q[User question to append to the bundle]:query:' \
                        '--query[User question to append to the bundle]:query:' \
                        '--clip[Also copy the bundle to clipboard]' \
                        '--rules[Include rules by filename globs]:glob:' \
                        '--no-preamble[Disable preamble and table of contents]' \
                        '--no-gitignore[Include gitignored files]' \
                        '--contexts-dir[Override contexts directory]:directory:_directories' \
                        '--responses-dir[Override responses directory]:directory:_directories' \
                        '--rules-dir[Override rules directory]:directory:_directories'
                    ;;
                paste)
                    _arguments \
                        ':label: ' \
                        '-x[Also extract files and apply patches]' \
                        '--extract[Also extract files and apply patches]' \
                        '--dry-run[Show what would happen without writing]' \
                        '--contexts-dir[Override contexts directory]:directory:_directories' \
                        '--responses-dir[Override responses directory]:directory:_directories' \
                        '--rules-dir[Override rules directory]:directory:_directories'
                    ;;
                extract)
                    _arguments \
                        ':input:file:_files' \
                        '-f[Force overwrite all existing files]' \
                        '--force[Force overwrite all existing files]' \
                        '--dry-run[Show actions without writing]' \
                        '--contexts-dir[Override contexts directory]:directory:_directories' \
                        '--responses-dir[Override responses directory]:directory:_directories' \
                        '--rules-dir[Override rules directory]:directory:_directories'
                    ;;
                log)
                    _arguments \
                        '--contexts-dir[Override contexts directory]:directory:_directories' \
                        '--responses-dir[Override responses directory]:directory:_directories' \
                        '--rules-dir[Override rules directory]:directory:_directories'
                    ;;
                setup)
                    _arguments \
                        '-i[Install shell completions for current shell]' \
                        '--install-completions[Install shell completions for current shell]' \
                        '-u[Uninstall shell completions]' \
                        '--uninstall-completions[Uninstall shell completions]'
                    ;;
            esac
            ;;
    esac
}

_mdfs "$@"
