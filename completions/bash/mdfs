# Bash completion for mdfs

_mdfs() {
    local cur prev words cword
    _init_completion || return

    local commands="init bundle paste extract log"

    local cmd=""
    local i
    for ((i = 1; i < cword; i++)); do
        case "${words[i]}" in
            -d|--dir) ((i++)) ;;
            init|bundle|paste|extract|log) cmd="${words[i]}"; break ;;
        esac
    done

    if [[ -z "$cmd" ]]; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "-d --dir --contexts-dir --responses-dir --rules-dir" -- "$cur"))
        else
            COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        fi
        return
    fi

    case "$cmd" in
        init) ;;
        bundle)
            case "$prev" in
                -o|--output|--contexts-dir|--responses-dir|--rules-dir) _filedir; return ;;
                -l|--label|-q|--query) return ;;
            esac
            COMPREPLY=($(compgen -W "-l --label -o --output -q --query --clip --rules --no-preamble --no-gitignore --contexts-dir --responses-dir --rules-dir" -- "$cur"))
            ;;
        paste)
            case "$prev" in
                -l|--label|--responses-dir) return ;;
            esac
            COMPREPLY=($(compgen -W "-l --label -x --extract --dry-run --contexts-dir --responses-dir --rules-dir" -- "$cur"))
            ;;
        extract)
            case "$prev" in
                -i|--input|--contexts-dir|--responses-dir|--rules-dir) _filedir; return ;;
            esac
            COMPREPLY=($(compgen -W "-i --input --dry-run --contexts-dir --responses-dir --rules-dir" -- "$cur"))
            ;;
        log) ;;
    esac
}

complete -F _mdfs mdfs
