#compdef mdfs

_mdfs() {
    local -a commands
    commands=(
        'init:Initialize .mdfs directory structure'
        'bundle:Bundle project files into a context Markdown file'
        'paste:Save clipboard as response, optionally extract files'
        'extract:Extract files and apply patches from Markdown'
        'log:Show chronological log of contexts and responses'
    )

    _arguments -C \
        '-d[Project directory]:directory:_directories' \
        '--dir[Project directory]:directory:_directories' \
        '1:command:->command' \
        '*::arg:->args'

    case "$state" in
        command)
            _describe -t commands 'mdfs command' commands
            ;;
        args)
            case "$words[1]" in
                init) ;;
                bundle)
                    _arguments \
                        '-f[Files to include]:*:file:_files' \
                        '--files[Files to include]:*:file:_files' \
                        '-l[Label for context file]:label:' \
                        '--label[Label for context file]:label:' \
                        '-s[System prompt file]:file:_files' \
                        '--system-prompt[System prompt file]:file:_files' \
                        '-o[Output file]:file:_files' \
                        '--output[Output file]:file:_files'
                    ;;
                paste)
                    _arguments \
                        '-l[Label for response file]:label:' \
                        '--label[Label for response file]:label:' \
                        '-x[Also extract files]' \
                        '--extract[Also extract files]' \
                        '--dry-run[Show actions without writing]'
                    ;;
                extract)
                    _arguments \
                        '-i[Input Markdown file]:file:_files' \
                        '--input[Input Markdown file]:file:_files' \
                        '--dry-run[Show actions without writing]'
                    ;;
                log) ;;
            esac
            ;;
    esac
}

_mdfs "$@"
